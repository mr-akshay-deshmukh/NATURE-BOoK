# ==============================================================================
# Nature BoOk - Environment Configuration
# ==============================================================================

# Google Gemini API Key: Required for real-time biochemical remediation plans,
# multimodal waste sorting, circular economy generation, and threat evaluation.
# In AI Studio, this is automatically injected via the Secrets panel.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# Google Maps Platform Key: Required for live interactive rendering of the
# Global Threat Map with geo-located incident markers and status pins.
GOOGLE_MAPS_PLATFORM_KEY="YOUR_GOOGLE_MAPS_PLATFORM_KEY"
VITE_GOOGLE_MAPS_PLATFORM_KEY="YOUR_GOOGLE_MAPS_PLATFORM_KEY"

# APP_URL: The URL where this applet is hosted.
# Used for self-referential links, proxy endpoints, and callbacks.
APP_URL="http://localhost:3000"

# Server Port (Defaults to 3000)
PORT=3000
